<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>GPC.Checker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GPCGeometry" Version="2.0.1.6" />
    <PackageReference Include="GPCModel" Version="1.1.0" />
    <PackageReference Include="GPCUtilities" Version="2.0.0.5" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="call &quot;C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe&quot; &quot;$(ProjectDir)..\..\..\GPCConverters\GPCConverters.sln&quot; /p:Configuration=$(ConfigurationName) /l:FileLogger,Microsoft.Build.Engine;logfile=BuildFromDependantProject.log" />
  </Target>

</Project>
