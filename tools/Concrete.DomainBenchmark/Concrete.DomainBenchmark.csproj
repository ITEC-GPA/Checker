<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>GPCChecker.Test.Concrete</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildThisFileDirectory)../../../</RepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <Compile Include="Program.cs" />
    <Compile Include="../../GPCChecker.Test.Concrete/DomainPointContractTests.cs" />
    <Compile Include="$(SolverSource)/**/*.cs" Exclude="$(SolverSource)/obj/**;$(SolverSource)/bin/**;$(SolverSource)/Properties/AssemblyInfo.cs" />
    <Reference Include="DelaunayMesh"><HintPath>$(RepositoryRoot)/Geometry/DelaunayMesh/bin/Release/netstandard2.0/DelaunayMesh.dll</HintPath></Reference>
    <Reference Include="GPCGeometry"><HintPath>$(RepositoryRoot)/Geometry/GPCGeometry/bin/Release/netstandard2.0/GPCGeometry.dll</HintPath></Reference>
    <Reference Include="GPCModel"><HintPath>$(RepositoryRoot)/Model/Model/bin/Release/netstandard2.0/GPCModel.dll</HintPath></Reference>
    <Reference Include="GPCUtilities"><HintPath>$(RepositoryRoot)/Utilities/GPCUtilities/bin/Release/netstandard2.0/GPCUtilities.dll</HintPath></Reference>
  </ItemGroup>
</Project>
